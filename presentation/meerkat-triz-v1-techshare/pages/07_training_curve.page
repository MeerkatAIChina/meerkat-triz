    elementType: text
    bounds: [56, 34, 500, 16]
    content:
      style: "$kicker"
      wrap: false
      text: 01 · 模型与训练
  - elementId: title
    elementType: text
    bounds: [56, 56, 840, 34]
    content:
      style: "$title"
      wrap: false
      text: 训练曲线：best 在 step 2700，之后是过拟合爬坡
  - elementId: curve
    elementType: chart
    bounds: [56, 110, 560, 360]
    data:
      cols: [step, eval_loss]
