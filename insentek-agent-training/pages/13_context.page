pageType: content
background:
  type: solid
  color: "$paper"
elements:
  # ---------- 页眉 ----------
  - elementId: kicker
    elementType: text
    bounds: [56, 40, 420, 16]
    content:
      style: "$kicker"
      wrap: false
      text: |-
        02 · 智能体思维
  - elementId: title
    elementType: text
    bounds: [56, 62, 848, 36]
    content:
      style: "$h1"
      wrap: false
      text: |-
        上下文工程:Prompt Engineering 的下一站

  # ---------- 左区:上下文组成剖面(5 层) ----------
  # 层 1 系统提示
  - elementId: layer1-box
    elementType: shape
    bounds: [56, 148, 300, 46]
    shapeName: rect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$hair"}
  - elementId: layer1-accent
    elementType: shape
    bounds: [56, 148, 4, 46]
    shapeName: rect
    fill: {type: solid, color: "$pine"}
  - elementId: layer1-text
    elementType: text
    bounds: [72, 148, 276, 46]
    content:
      align: [left, middle]
      lineHeight: 1.3
      text: |-
        <p><span style="font-size:12.5px; color:$ink;"><strong>系统提示 · System Prompt</strong></span></p>
        <p><span style="font-size:10px; color:$muted;">角色、规则、输出要求</span></p>
  # 层 2 记忆
  - elementId: layer2-box
    elementType: shape
    bounds: [56, 202, 300, 46]
    shapeName: rect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$hair"}
  - elementId: layer2-accent
    elementType: shape
    bounds: [56, 202, 4, 46]
    shapeName: rect
    fill: {type: solid, color: "$pine"}
  - elementId: layer2-text
    elementType: text
    bounds: [72, 202, 276, 46]
    content:
      align: [left, middle]
      lineHeight: 1.3
      text: |-
        <p><span style="font-size:12.5px; color:$ink;"><strong>记忆 · Memory</strong></span></p>
        <p><span style="font-size:10px; color:$muted;">偏好、历史结论、项目背景</span></p>
  # 层 3 检索资料
  - elementId: layer3-box
    elementType: shape
    bounds: [56, 256, 300, 46]
    shapeName: rect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$hair"}
  - elementId: layer3-accent
    elementType: shape
    bounds: [56, 256, 4, 46]
    shapeName: rect
    fill: {type: solid, color: "$pine"}
  - elementId: layer3-text
    elementType: text
    bounds: [72, 256, 276, 46]
    content:
      align: [left, middle]
      lineHeight: 1.3
      text: |-
        <p><span style="font-size:12.5px; color:$ink;"><strong>检索资料 · RAG</strong></span></p>
        <p><span style="font-size:10px; color:$muted;">知识库、文档、实时数据</span></p>
  # 层 4 工具说明
  - elementId: layer4-box
    elementType: shape
    bounds: [56, 310, 300, 46]
    shapeName: rect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$hair"}
  - elementId: layer4-accent
    elementType: shape
    bounds: [56, 310, 4, 46]
    shapeName: rect
    fill: {type: solid, color: "$pine"}
  - elementId: layer4-text
    elementType: text
    bounds: [72, 310, 276, 46]
    content:
      align: [left, middle]
      lineHeight: 1.3
      text: |-
        <p><span style="font-size:12.5px; color:$ink;"><strong>工具说明 · Tools</strong></span></p>
        <p><span style="font-size:10px; color:$muted;">可用工具清单与参数说明</span></p>
  # 层 5 对话历史(Prompt 所在层,terra 强调)
  - elementId: layer5-box
    elementType: shape
    bounds: [56, 364, 300, 46]
    shapeName: rect
    fill: {type: solid, color: "$white"}
    border: {style: solid, width: 1, color: "$hair"}
  - elementId: layer5-accent
    elementType: shape
    bounds: [56, 364, 4, 46]
    shapeName: rect
    fill: {type: solid, color: "$terra"}
  - elementId: layer5-text
    elementType: text
    bounds: [72, 364, 276, 46]
    content:
      align: [left, middle]
      lineHeight: 1.3
      text: |-
        <p><span style="font-size:12.5px; color:$ink;"><strong>对话历史 · History</strong></span></p>
        <p><span style="font-size:10px; color:$muted;">多轮对话 + 你最新的提问</span></p>
  - elementId: layer5-note
    elementType: text
    bounds: [72, 416, 284, 14]
    content:
      fontSize: 10.5
      color: "$terra"
      wrap: false
      text: |-
        ▲ 你写的 Prompt,住在第 5 层——只是其中一小块
  # 拼成箭头
  - elementId: merge-chevron
    elementType: shape
    bounds: [372, 260, 34, 40]
    shapeName: chevron
    fill: {type: solid, color: "$pine"}
  - elementId: merge-label
    elementType: text
    bounds: [364, 306, 50, 14]
    content:
      fontSize: 10
      color: "$muted"
      align: [center, top]
      wrap: false
      text: |-
        拼成
  # 模型看到的完整世界
  - elementId: world-box
    elementType: shape
    bounds: [424, 186, 176, 190]
    shapeName: rect
    fill: {type: solid, color: "$pine"}
  - elementId: world-icon
    elementType: icon
    bounds: [496, 212, 32, 32]
    iconName: "fas:globe"
    fill: {type: solid, color: "$paper"}
  - elementId: world-title
    elementType: text
    bounds: [424, 254, 176, 48]
    content:
      align: [center, top]
      lineHeight: 1.35
      text: |-
        <p><span style="font-size:16px; color:$paper;"><strong>模型看到的</strong></span></p>
        <p><span style="font-size:16px; color:$paper;"><strong>完整世界</strong></span></p>
  - elementId: world-caption
    elementType: text
    bounds: [424, 312, 176, 18]
    content:
      fontSize: 10
      color: "#D8D3C8"
      align: [center, top]
      wrap: false
      text: |-
        = 上下文窗口(Context)
  - elementId: world-note
    elementType: text
    bounds: [412, 388, 200, 32]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [center, top]
      lineHeight: 1.5
      text: |-
        模型回答的是这整个世界,不只是你那句话。

  # ---------- 右栏:定义 + 检查 ----------
  - elementId: def-label
    elementType: text
    bounds: [640, 148, 264, 22]
    content:
      style: "$h2"
      wrap: false
      text: |-
        从写好一段话,到经营一个世界
  - elementId: def-body
    elementType: text
    bounds: [640, 180, 264, 84]
    content:
      fontSize: 12
      color: "$ink"
      lineHeight: 1.55
      align: [left, top]
      text: |-
        Prompt Engineering(第二期)优化的是第 5 层里的那段话;上下文工程(Context Engineering)经营的是全部 5 层——模型看到的一切。
  - elementId: check-box
    elementType: shape
    bounds: [640, 284, 264, 108]
    shapeName: rect
    fill: {type: solid, color: "$paleG"}
  - elementId: check-title
    elementType: text
    bounds: [656, 296, 232, 18]
    content:
      fontSize: 12.5
      bold: true
      color: "$pine"
      wrap: false
      text: |-
        想一想
  - elementId: check-desc
    elementType: text
    bounds: [656, 318, 232, 66]
    content:
      fontSize: 11
      color: "$ink"
      lineHeight: 1.55
      align: [left, top]
      text: |-
        为什么同一句话,换个上下文效果天差地别?因为模型回应的不是这句话,而是它看到的整个世界
  - elementId: link-note
    elementType: text
    bounds: [640, 412, 264, 32]
    content:
      style: "$small"
      align: [left, top]
      text: |-
        与第二期衔接:Prompt 没有过时——它是上下文的一部分。

  # ---------- 页脚 ----------
  - elementId: footer-line
    elementType: line
    bounds: [56, 501, 848, 2]
    viewBox: [848, 2]
    points: "0,1 848,1"
    border: {style: solid, width: 1, color: "$hair"}
  - elementId: footer-left
    elementType: text
    bounds: [56, 510, 560, 14]
    content:
      style: "$caption"
      wrap: false
      text: |-
        东方智感 · AI 内训第三期
  - elementId: footer-right
    elementType: text
    bounds: [804, 510, 100, 14]
    content:
      style: "$caption"
      align: [right, top]
      wrap: false
      text: |-
        13
