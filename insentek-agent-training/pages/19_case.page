pageType: content
background:
  type: solid
  color: "$paper"
notes: 案例演示:墒情巡检报告智能体五步流程(目标→行动→反馈→验证→交付),每步标注对应 Loop 要素;验证不通过回到行动;效果对比为教学演示数据;检查提问聚焦最容易被省掉的环节。
elements:
  - elementId: kicker
    elementType: text
    bounds: [56, 38, 500, 16]
    content:
      style: "$kicker"
      wrap: false
      text: 第三章 · HARNESS 与 LOOP ENGINEERING
  - elementId: title
    elementType: text
    bounds: [56, 62, 848, 36]
    content:
      style: "$h1"
      wrap: false
      text: 案例:墒情巡检报告智能体,完整跑一圈
  # ---- 五步横向流程 ----
  - elementId: step-1-tag
    elementType: text
    bounds: [56, 132, 152, 14]
    content:
      fontSize: 10
      bold: true
      color: "$terra"
      align: [center, top]
      wrap: false
      text: LOOP · 目标
  - elementId: step-1
    elementType: shape
    bounds: [56, 152, 152, 118]
    shapeName: rect
    fill: {type: solid, color: "$white"}
