  - elementId: step-5
    elementType: shape
    bounds: [784, 152, 120, 118]
    shapeName: rect
    fill: {type: solid, color: "$paleT"}
    border: {style: solid, width: 1, color: "$terra"}
  - elementId: step-5-t
    elementType: text
    bounds: [796, 164, 96, 18]
    content:
