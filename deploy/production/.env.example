# ================================================================
# Meerkat-TRIZ-v1 生产环境配置
# 复制本文件为 .env 并修改实际值
# ================================================================

# ───────────────────────────────────────────────────────────────
# 镜像版本
# ───────────────────────────────────────────────────────────────
# vLLM 推理镜像（基于 vllm/vllm-openai:v0.25.0 arm64 + PyAV）
# 如需从 Dockerfile 构建：deploy/qwen36-vllm/Dockerfile
VLLM_IMAGE=qwen36-dgx-spark:v0.1.1

# Open WebUI 镜像
WEBUI_IMAGE=ghcr.io/open-webui/open-webui:ollama

# ───────────────────────────────────────────────────────────────
# 模型路径（宿主机绝对路径）
# ───────────────────────────────────────────────────────────────
# HuggingFace 缓存目录（存放基座模型权重）
HF_HOME=/home/meerkat/.cache/huggingface

# LoRA 适配器权重目录（已下载的 Meerkat-TRIZ-v1 适配器）
LORA_DIR=/home/meerkat/.cache/vllm/loras/meerkat-triz-v1

# ───────────────────────────────────────────────────────────────
# vLLM 推理参数
# ───────────────────────────────────────────────────────────────
# 基座模型 HuggingFace ID 或本地路径
BASE_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4-Fast

# 数据类型：float16（NVFP4 量化基座使用 float16 计算）
VLLM_DTYPE=float16

# 最大上下文长度（与模型规格一致）
MAX_MODEL_LEN=262144

# GPU 显存利用率上限（留余量给 LoRA 和 KV cache）
GPU_MEM_UTIL=0.83

# 最大 batch tokens
MAX_BATCHED_TOKENS=8192

# 最大并发序列数
MAX_NUM_SEQS=64

# 推测解码 token 数（MTP）
NUM_SPEC_TOKENS=3

# LoRA rank（必须与训练配置一致）
LORA_RANK=64

# vLLM API 基础地址（Open WebUI 容器内访问）
VLLM_BASE_URL=http://host.docker.internal:8000/v1

# ───────────────────────────────────────────────────────────────
# Open WebUI 配置
# ───────────────────────────────────────────────────────────────
# WebUI 暴露端口
WEBUI_PORT=12001

# 应用名称
WEBUI_NAME=Meerkat-TRIZ

# API 密钥（本地部署无认证，填任意值）
OPENAI_API_KEY=local

# ★ 默认生成参数（JSON 字符串，必须用单引号包裹）
# 说明：
#   - temperature=0.6：避免贪心解码导致的重复循环
#   - top_p=0.95： nucleus sampling
#   - repetition_penalty=1.05：轻微抑制重复
#   - max_new_tokens=16384：限制最长生成，防止无限生成
OVERRIDE_GENERATION_CONFIG='{"temperature":0.6,"top_p":0.95,"repetition_penalty":1.05,"max_new_tokens":16384}'

# ───────────────────────────────────────────────────────────────
# 用户注册与权限
# ───────────────────────────────────────────────────────────────
# 是否开启自助注册
ENABLE_SIGNUP=true

# 新用户默认角色：user（直接可用）/ pending（需 admin 审批）
DEFAULT_USER_ROLE=user

# 是否显示登录表单
ENABLE_LOGIN_FORM=true

# ───────────────────────────────────────────────────────────────
# HuggingFace 镜像（中国大陆可选）
# ───────────────────────────────────────────────────────────────
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_ENDPOINT=https://hf-mirror.com

# ───────────────────────────────────────────────────────────────
# 可选：SMTP 邮件验证（如需邮箱验证则配置）
# ───────────────────────────────────────────────────────────────
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=your-smtp-password
